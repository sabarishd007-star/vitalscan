# VitalScan ML backend environment
# Copy to .env and fill in real values. All variables are optional in
# development (see defaults in main.py); the first three are for production.

# development | production. In production ALLOWED_ORIGINS is required.
APP_ENV=production

# Comma-separated frontend origins allowed by CORS. No wildcards.
ALLOWED_ORIGINS=https://app.yourdomain.com

# Set true only after the deployed model has been independently validated and
# approved for real use. The /health response reports production_model_validated.
MODEL_VALIDATED=false

# Human-readable label surfaced in /health (e.g. a model card version).
MODEL_VERSION=distilled-cv-v1

# Supabase persistence for reports (report_history) and profiles (profiles).
# When unset/placeholder, the backend falls back to local JSON files under
# ml-backend/data/ (gitignored) — fine for development.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Tip: apply the schema with the SQL files under supabase/migrations/.
