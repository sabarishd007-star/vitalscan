VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Required in deployed environments. Use an HTTPS API domain; do not use localhost.
VITE_ML_BACKEND_URL=https://api-skin-analysis.yourdomain.com

# Development only. Never enable this in a deployed environment because it can
# return an unvalidated browser-side estimate when the API is unavailable.
VITE_ALLOW_LOCAL_ANALYSIS_FALLBACK=false
